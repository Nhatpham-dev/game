{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Registered player profile in the survival world",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique account identifier",
          "maxLength": 128
        },
        "username": {
          "type": "string",
          "description": "Display username of the resident",
          "maxLength": 64
        },
        "pin": {
          "type": "string",
          "description": "4-digit security PIN",
          "maxLength": 10
        },
        "createdAt": {
          "type": "number",
          "description": "Account registration timestamp"
        }
      },
      "required": ["id", "username", "pin", "createdAt"]
    },
    "Character": {
      "title": "Character",
      "description": "Survival character walking in the world with real-time stats and coordinates",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique character ID",
          "maxLength": 128
        },
        "accountId": {
          "type": "string",
          "description": "Associated user account ID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Character name",
          "maxLength": 64
        },
        "bestSkillId": {
          "type": "string",
          "description": "Key skill ID",
          "maxLength": 64
        },
        "appearance": {
          "type": "string",
          "description": "Serialized appearance configuration",
          "maxLength": 1000
        },
        "stats": {
          "type": "string",
          "description": "Serialized JSON stats for hunger, energy, comfort, money",
          "maxLength": 1000
        },
        "x": {
          "type": "number",
          "description": "X coordinate on the world map"
        },
        "y": {
          "type": "number",
          "description": "Y coordinate on the world map"
        },
        "direction": {
          "type": "string",
          "description": "Facing direction",
          "maxLength": 16
        },
        "isMoving": {
          "type": "boolean",
          "description": "Movement flag"
        },
        "isWorking": {
          "type": "boolean",
          "description": "Working flag"
        },
        "lastSeen": {
          "type": "number",
          "description": "Last active timestamp"
        }
      },
      "required": ["id", "accountId", "name", "x", "y"]
    },
    "BuildingZone": {
      "title": "BuildingZone",
      "description": "Storefront lot or public facility in the city",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique building lot ID",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Store name",
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "description": "Building classification",
          "maxLength": 50
        },
        "x": {
          "type": "number",
          "description": "Lot X coordinate"
        },
        "y": {
          "type": "number",
          "description": "Lot Y coordinate"
        },
        "width": {
          "type": "number",
          "description": "Building width"
        },
        "height": {
          "type": "number",
          "description": "Building height"
        },
        "color": {
          "type": "string",
          "description": "Main color hex code",
          "maxLength": 30
        },
        "roofColor": {
          "type": "string",
          "description": "Roof color hex code",
          "maxLength": 30
        },
        "icon": {
          "type": "string",
          "description": "Lot emoji icon",
          "maxLength": 20
        },
        "title": {
          "type": "string",
          "description": "Title display",
          "maxLength": 100
        },
        "subtitle": {
          "type": "string",
          "description": "Subtitle display",
          "maxLength": 150
        },
        "isCustomizable": {
          "type": "boolean",
          "description": "Whether store can be customized"
        },
        "isOwned": {
          "type": "boolean",
          "description": "Whether stall is actively opened"
        },
        "ownerId": {
          "type": "string",
          "description": "Owner account ID",
          "maxLength": 128
        },
        "ownerName": {
          "type": "string",
          "description": "Owner display name",
          "maxLength": 64
        },
        "businessSectorId": {
          "type": "string",
          "description": "Business sector ID",
          "maxLength": 64
        },
        "businessSectorName": {
          "type": "string",
          "description": "Business sector title",
          "maxLength": 100
        },
        "productsJson": {
          "type": "string",
          "description": "JSON string of products and prices",
          "maxLength": 10000
        },
        "totalRevenue": {
          "type": "number",
          "description": "Accumulated store revenue"
        },
        "totalSalesCount": {
          "type": "number",
          "description": "Total sales volume"
        }
      },
      "required": ["id", "name", "x", "y", "width", "height"]
    },
    "LogEvent": {
      "title": "LogEvent",
      "description": "Real-time world activity and trade logs",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Log entry unique ID",
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "description": "Event description",
          "maxLength": 300
        },
        "type": {
          "type": "string",
          "description": "Category of log",
          "maxLength": 30
        },
        "timestamp": {
          "type": "number",
          "description": "Log timestamp"
        }
      },
      "required": ["id", "message", "type", "timestamp"]
    }
  },
  "firestore": {
    "/accounts/{accountId}": {
      "schema": {
        "$ref": "#/entities/UserAccount"
      },
      "description": "Registered player accounts in the survival city"
    },
    "/characters/{characterId}": {
      "schema": {
        "$ref": "#/entities/Character"
      },
      "description": "Live characters with coordinates and survival stats"
    },
    "/buildings/{buildingId}": {
      "schema": {
        "$ref": "#/entities/BuildingZone"
      },
      "description": "Stalls and shops across the city map"
    },
    "/logs/{logId}": {
      "schema": {
        "$ref": "#/entities/LogEvent"
      },
      "description": "World logs and transaction feed"
    }
  }
}
