rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 2. Accounts: Player profiles in the survival city
    match /accounts/{accountId} {
      allow read: if true;
      allow create, update: if isValidId(accountId) &&
        request.resource.data.id is string &&
        request.resource.data.id.size() <= 128 &&
        request.resource.data.username is string &&
        request.resource.data.username.size() <= 64;
      allow delete: if isValidId(accountId);
    }

    // 3. Characters: Real-time positions, direction, and survival stats
    match /characters/{characterId} {
      allow read: if true;
      allow create, update: if isValidId(characterId) &&
        request.resource.data.id is string &&
        request.resource.data.id.size() <= 128 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 64 &&
        request.resource.data.x is number &&
        request.resource.data.y is number;
      allow delete: if isValidId(characterId);
    }

    // 4. Buildings: Stalls, shops, and prices synchronized across devices
    match /buildings/{buildingId} {
      allow read: if true;
      allow create, update: if isValidId(buildingId) &&
        request.resource.data.id is string &&
        request.resource.data.id.size() <= 128 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 100;
      allow delete: if isValidId(buildingId);
    }

    // 5. Logs: Shared world events and trade feed
    match /logs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId);
      allow update, delete: if false;
    }

    // 6. Negotiations: Two-way live chat between booth owner and customer
    match /negotiations/{negId} {
      allow read: if true;
      allow create, update: if isValidId(negId);
      allow delete: if isValidId(negId);
    }
  }
}
